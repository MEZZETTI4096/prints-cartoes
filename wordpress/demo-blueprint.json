{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Cartões de Visitas | Gráfica Print's (demonstração)",
    "description": "WordPress de demonstração com o plugin Print's Páginas instalado e a página /cartoes importada.",
    "author": "Gráfica Print's"
  },
  "landingPage": "/cartoes/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Gráfica Print's",
        "permalink_structure": "/%postname%/",
        "timezone_string": "America/Sao_Paulo"
      }
    },
    {
      "step": "setSiteLanguage",
      "language": "pt_BR"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/MEZZETTI4096/prints-cartoes/main/wordpress/dist/prints-paginas.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/paginas.zip",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/MEZZETTI4096/prints-cartoes/main/wordpress/dist/paginas-todas.zip"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; prints_paginas_importar_zip('/tmp/paginas.zip', true); flush_rewrite_rules();"
    }
  ]
}
